# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic API key for Claude vision classification.
# Get yours at: https://console.anthropic.com → API Keys → Create key
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Pexels API key — only needed to download test images for evaluation.
# Free tier: 200 requests/hour. Get yours at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key_here
